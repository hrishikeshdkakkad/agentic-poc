# Plaid API credentials (production).
# Get these from the Plaid dashboard: https://dashboard.plaid.com → Team Settings → API.
# Use the production secret (not sandbox) to talk to real bank data.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Per-Item access tokens — one per linked bank.
# Populated by running `uvicorn link_helper:app --port 8765` locally (see README).
# Pattern: PLAID_TOKEN_<INSTITUTION_NAME_UPPERCASE>
# Examples (add/remove as you link banks):
# PLAID_TOKEN_CHASE=
# PLAID_TOKEN_FIDELITY=
# PLAID_TOKEN_AMEX=

# History store — any Postgres. For Neon (https://neon.tech): create a
# project, copy the connection string, keep sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.aws.neon.tech/finance?sslmode=require

# Optional split store: keep the plaid_tokens table (encrypted access tokens)
# in a different database from the history store — e.g. local-only Postgres —
# so credentials never reach the managed database. Defaults to DATABASE_URL.
# PFM_TOKENS_DATABASE_URL=

# Token encryption key. Plaid access tokens are Fernet-encrypted and stored
# in the plaid_tokens table; the key stays out of the database. Either set
# FERNET_KEY explicitly (python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())") or leave unset to auto-generate a
# chmod-600 keyfile under PFM_SECRETS_DIR (default ~/.config/personal-finance-mcp).
# FERNET_KEY=
# PFM_SECRETS_DIR=

# Deployment guard — set to any truthy value in your deployment environment.
# When set, `link_helper.py` refuses to run (it's a local-only tool). Leave
# unset locally so the helper works.
# HORIZON=1
