<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personal-finance-mcp.server</string>

    <!-- Exec the real Homebrew binary directly: launching through the
         .venv symlink (inside TCC-protected ~/Documents) is denied by
         tccd even when the binary itself holds Full Disk Access. The
         venv is supplied via PYTHONPATH instead of pyvenv.cfg.
         NOTE: Cellar path changes on brew python upgrades - update both
         this file and the Full Disk Access grant when that happens.
         (Same pattern as com.personal-finance-mcp.dashboard.) -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/Cellar/python@3.11/3.11.14_3/Frameworks/Python.framework/Versions/3.11/bin/python3.11</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>asgi:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
        <string>--reload</string>
        <string>--reload-exclude</string>
        <string>deploy/*</string>
        <string>--reload-exclude</string>
        <string>.venv/*</string>
        <string>--reload-exclude</string>
        <string>dashboard/*</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/hrishikeshkakkad/Documents/agentic-poc/.venv/lib/python3.11/site-packages</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/hrishikeshkakkad/Documents/agentic-poc</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/hrishikeshkakkad/Library/Logs/personal-finance-mcp-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hrishikeshkakkad/Library/Logs/personal-finance-mcp-server.log</string>
</dict>
</plist>
